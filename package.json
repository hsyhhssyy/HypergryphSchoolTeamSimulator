{
  "name": "h5-spot-diff-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "questions:build": "node --experimental-strip-types scripts/build-question-bank.ts",
    "questions:check": "node --experimental-strip-types scripts/build-question-bank.ts --check",
    "predev": "npm run questions:build",
    "dev": "vite",
    "prebuild": "npm run questions:build",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && vite build",
    "preview": "vite preview",
    "optimize:assets": "node scripts/optimize-title-image.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "heic-to": "^1.5.2",
    "preact": "^10.29.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.1",
    "preact-render-to-string": "^6.7.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
